{
  "name": "@comchatx/cx-assistant",
  "version": "0.1.6",
  "description": "Does the work with your plugins, giving reasons and sources.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-assistant.git"
  },
  "bugs": "https://github.com/comchatx/cx-assistant/issues",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist",
    "skills",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "用你装的插件把事做完，提建议时附上理由和出处。",
    "mark": {
      "line": "document"
    },
    "section": "extensions",
    "order": 90
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "esbuild": "0.27.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
